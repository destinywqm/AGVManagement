<Window x:Class="AGVManagement.RepositioningTag"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AGVManagement"
        mc:Ignorable="d"
        Title="重定位" Height="212" Width="287" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- 重新定义行布局 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 站点行 -->
            <RowDefinition Height="Auto"/>
            <!-- Angle行 -->
            <RowDefinition Height="Auto"/>
            <!-- 按钮行 -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- Label列 -->
            <ColumnDefinition Width="*"/>
            <!-- 输入框/下拉框列 -->
        </Grid.ColumnDefinitions>

        <!-- 站点输入 -->
        <Label Content="站点:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <TextBox x:Name="dataMes" Grid.Row="0" Grid.Column="1" Width="170" Height="30" Margin="10"/>

        <!-- Angle 选择 -->
        <Label Content="Angle:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
        <ComboBox x:Name="dataMes3" Grid.Row="1" Grid.Column="1" Width="170" Height="30" Margin="10" SelectionChanged="dataMes3_SelectionChanged">
            <ComboBoxItem Content="0"/>
            <ComboBoxItem Content="1.57"/>
            <ComboBoxItem Content="3.14"/>
            <ComboBoxItem Content="-1.57"/>
        </ComboBox>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="完成" Click="OnCompleteButtonClick" Width="100" Margin="5"/>
            <Button Content="取消" Click="OnCancelButtonClick" Width="100" Margin="5"/>
        </StackPanel>

    </Grid>
</Window>