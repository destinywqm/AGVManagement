<Window x:Class="AGVManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AGVManagement"
        mc:Ignorable="d"
        Title="地图管理" Height="700" Width="1240" Icon="Images/Map.png"  Background="White" MinWidth="1240" MinHeight="700" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="111*"/>
            <ColumnDefinition Width="99*"/>
            <ColumnDefinition Width="410*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="207.333"></ColumnDefinition>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="119*"></ColumnDefinition>
                <ColumnDefinition Width="33*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions >
                <RowDefinition Height="150"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <GroupBox Margin="0,5,0,0" Grid.Row="0" Width="187" Height="150" HorizontalAlignment="Center" VerticalAlignment="Top" Header="地图信息" Grid.RowSpan="2" Background="#A9A9A9">
                <GroupBox.Content>
                    <Grid Margin="1,10,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <!-- 新的一行 -->
                        </Grid.RowDefinitions>

                        <!-- 控件 -->
                        <Label Name="Numbrt" Width="80" Content="地图名称：" FontSize="12" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                        <TextBox FontSize="12" Name="MP" Width="110" Height="NaN" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="1,2,0,3"/>

                        <Label Content="地图宽："  FontSize="12" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="0"/>
                        <Label Content="0" Name="MpWidth" Grid.Row="1" FontSize="12"  VerticalContentAlignment="Center" RenderTransformOrigin="-0.102,0.406" Margin="45,1,20,1" Grid.ColumnSpan="2"/>
                        <Label Content="地图高："  FontSize="12" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="2"/>
                        <Label Content="0"  FontSize="12" Name="MpHeight" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" RenderTransformOrigin="-0.731,0.49" Grid.ColumnSpan="2" Margin="43,0,0,0"/>
                        <!-- 地图类型 -->
                        <Label Content="地图类型："  FontSize="12" VerticalContentAlignment="Center" Grid.Row="2" Grid.Column="0"/>
                        <ComboBox  Width="110" FontSize="12" Name="TypeMp" Height="NaN" SelectedIndex="0" Grid.ColumnSpan="3" Margin="1,2,19,2" Grid.Column="1" Grid.Row="2">
                            <ComboBoxItem>RFID</ComboBoxItem>
                            <ComboBoxItem>磁标</ComboBoxItem>
                            <ComboBoxItem>激光</ComboBoxItem>
                        </ComboBox>

                        <!-- 新的一行中的控件 -->
                        <Button Name="Save" Content="保存" FontSize="12" Height="24" Padding="5,0" Cursor="Hand" Grid.Row="3" Grid.Column="0" Margin="25,0,0,0" HorizontalAlignment="Left" Width="40" Click="Save_Click" Grid.ColumnSpan="2"/>
                        <Button Name="Export" Content="导出" FontSize="12" Height="24" Padding="5,0" Grid.Row="3" Width="44" Click="Export_Click" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="25,0,0,0"/>
                    </Grid>
                </GroupBox.Content>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="工具栏" Margin="0,11,0,11" HorizontalAlignment="Center" Background="#D3D3D3"  Width="186">
                <GroupBox.Content>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-2,0">
                        <StackPanel Name="Palern">
                            <Grid Cursor="">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28*"></ColumnDefinition>
                                    <ColumnDefinition Width="163*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <!-- 按钮实例 -->
                                <Button x:Name="btn_mouse" Content="指针" Grid.Row="0" Width="100" Height="30" Margin="18,10,0,0" Click="btn_mouse_Click" Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" HorizontalAlignment="Left" Grid.Column="1" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Name="DeleteCircuit" Content="清除路线" Grid.Row="1" Width="100" Height="30" Margin="18,10,0,0" Click="DeleteCircuit_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>


                                <Button x:Name="Tags" Content="信标" Grid.Row="2" Width="100" Height="30" Margin="18,10,0,0" Click="Tags_Click" Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="Straight" Content="直线路线" Grid.Row="3" Width="100" Height="30" Margin="18,10,0,0" Click="Straight_Click"
                        Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="折线路线" Name="Broken" Grid.Row="4" Width="100" Height="30" Margin="18,10,0,0" Click="Broken_Click"
                        Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="半圆" Name="Btn_cren" Grid.Row="5" Width="100" Height="30" Margin="18,10,0,0" Click="Btn_cren_Click"
                        Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="曲线" Name="Btn_bezierCurve" Grid.Row="6" Width="100" Height="30" Margin="18,10,0,0" Click="Btn_bezierCurve_Click"
                        Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="启动任务" Name="TaskTestingPlanning" Grid.Row="13" Width="100" Height="30" Margin="18,10,0,0" Click="Btn_TaskTesting_Click"
Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                
                                <Button Content="连接AMR" Name="Btn_Text" Grid.Row="15" Width="100" Height="30" Margin="18,10,0,0" Click="Btn_Text_Click" Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="Mes连接" Grid.Row="7" Width="100" Height="30" Margin="18,10,0,0" Name="Area" Click="Area_Click"
                        Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="充电" Name="InsertImg" Grid.Row="8" Width="98" Height="30" Margin="18,10,0,0" Click="InsertImg_Click" VerticalAlignment="Top" Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="重定位" Grid.Row="9" Width="100" Height="30" Margin="18,10,0,0" Click="LoadFromFile_Click"
                        Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="Mes" Grid.Row="10" Width="100" Height="30" Margin="18,10,0,0" Click="OnInputLineButtonClick"
                        Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="建图" Name="Btn_RoutePlanning" Grid.Row="11" Width="100" Height="30" Margin="18,10,0,0" Click="RoutePlanningButtonClick"
                        Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="定位" Name="Btn_LineDistribution" Grid.Row="12" Width="100" Height="30" Margin="18,10,0,0" Click="LineDistributionButtonClick"
                        Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="终止任务" Name="TerminationPlanning" Grid.Row="14" Width="100" Height="30" Margin="18,10,0,0" Click="Btn_TaskTermination_Click"
Background="#607D8B" Foreground="White" BorderBrush="#455A64" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Label Content="地图比例尺：" FontSize="12" Grid.Row="16" Width="100" Margin="32,20,31,28" Grid.Column="1" Grid.RowSpan="2"></Label>
                                <Slider x:Name="SliMax" Grid.Row="18" Cursor="Hand" Margin="32,10,60,0" Maximum="5" Minimum="0" TickFrequency="1" ValueChanged="SliMax_ValueChanged" Grid.Column="1"></Slider>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox.Content>
            </GroupBox>
            <ContentControl Style="{StaticResource panel-default}" Margin="10,25,10,85" Grid.Row="0"  Grid.Column="2" Height="40" Grid.ColumnSpan="2" Background="#46CBD9">
                <StackPanel>
                    <ContentControl Style="{StaticResource panel-heading-default}" Content="地图编辑"/>
                </StackPanel>
            </ContentControl>
            <Grid Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Margin="10,54,10,10" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- X轴刻度栏 -->
                <ScrollViewer Name="SrcX" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Hidden">
                    <StackPanel Background="#FFF5F2F2">
                        <Canvas Name="TopX" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 左上角固定的 0 标签 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Background="#FFF5F2F2">
                    <Label Content="0" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="13" />
                </StackPanel>

                <!-- Y轴刻度栏 -->
                <ScrollViewer Name="SrcY" Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Background="#FFF5F2F2">
                        <Canvas Name="TopY" Width="25" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 地图主体 -->
                <ScrollViewer Name="SrcCount" Grid.Column="1" Grid.Row="1"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  ScrollChanged="SrcCount_ScrollChanged"
                  PreviewMouseWheel="SrcCount_PreviewMouseWheel" PreviewMouseRightButtonDown="SrcCount_PreviewMouseRightButtonDown">
                    <Border BorderBrush="#1F000000" BorderThickness="1">
                        <StackPanel Name="Geenh" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel.LayoutTransform>
                                <ScaleTransform x:Name="MapScaleTransform" ScaleX="1" ScaleY="1"/>
                            </StackPanel.LayoutTransform>
                            <StackPanel.Background>
                                <ImageBrush ImageSource="Images/20241206.png" />
                            </StackPanel.Background>
                            <Canvas Name="mainPanel" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
