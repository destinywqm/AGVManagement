<Window x:Class="AGVManagement.AddMap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加地图"
        Height="480" Width="420"
        Icon="Images/添加地图.png"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- 地图名称 -->
            <Label Content="地图名称:" Grid.Row="0" Grid.Column="0"
                   FontSize="16"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>
            <TextBox Name="MapSizeN" Grid.Row="0" Grid.Column="1"
                     FontSize="16"
                     VerticalContentAlignment="Center"/>

            <!-- 原始宽度 -->
            <Label Content="原始宽度:" Grid.Row="1" Grid.Column="0"
                   FontSize="16"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>
            <TextBox Name="RawWidth" Grid.Row="1" Grid.Column="1"
                     FontSize="16"
                     VerticalContentAlignment="Center"/>

            <!-- 原始高度 -->
            <Label Content="原始高度:" Grid.Row="2" Grid.Column="0"
                   FontSize="16"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>
            <TextBox Name="RawHeight" Grid.Row="2" Grid.Column="1"
                     FontSize="16"
                     VerticalContentAlignment="Center"/>

            <!-- 分辨率 -->
            <Label Content="分辨率:" Grid.Row="3" Grid.Column="0"
                   FontSize="16"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>
            <TextBox Name="Resolution" Grid.Row="3" Grid.Column="1"
                     FontSize="16"
                     VerticalContentAlignment="Center"/>

            <!-- 原点X -->
            <Label Content="原点X:" Grid.Row="4" Grid.Column="0"
                   FontSize="16"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>
            <TextBox Name="OriginX" Grid.Row="4" Grid.Column="1"
                     FontSize="16"
                     VerticalContentAlignment="Center"/>

            <!-- 原点Y -->
            <Label Content="原点Y:" Grid.Row="5" Grid.Column="0"
                   FontSize="16"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>
            <TextBox Name="OriginY" Grid.Row="5" Grid.Column="1"
                     FontSize="16"
                     VerticalContentAlignment="Center"/>

            <!-- 缩放倍数 -->
            <Label Content="缩放倍数:" Grid.Row="6" Grid.Column="0"
                   FontSize="16"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>
            <TextBox Name="ScaleFactor" Grid.Row="6" Grid.Column="1"
                     FontSize="16"
                     VerticalContentAlignment="Center"/>

            <!-- 导入图片 -->
            <Label Content="导入图片:" Grid.Row="7" Grid.Column="0"
                   FontSize="16"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>
            <Button Content="选择图片"
                    Name="ImportImageBtn"
                    Click="ImportImageBtn_Click"
                    Grid.Row="7" Grid.Column="1"
                    Width="120"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>

            <!-- 按钮 -->
            <StackPanel Grid.Row="8" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button Content="确定"
                        Name="MapSum"
                        Click="MapSum_Click"
                        Width="120" Height="40"
                        Margin="10"/>

                <Button Content="取消"
                        Name="OFFMp"
                        Click="OFFMp_Click"
                        Width="120" Height="40"
                        Margin="10"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>