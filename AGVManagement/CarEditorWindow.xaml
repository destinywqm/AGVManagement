<Window x:Class="AGVManagement.CarEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="车辆模型编辑" Height="500" Width="850"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧表单 -->
        <StackPanel Grid.Column="0" VerticalAlignment="Top">
            <!-- 每一行用 Grid 两列布局 -->
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="车辆类型:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="TypeComboBox">
                    <ComboBoxItem Content="AGV"/>
                    <ComboBoxItem Content="叉车"/>
                    <ComboBoxItem Content="牵引车"/>
                </ComboBox>
            </Grid>

            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="车辆名称:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="NameTextBox"/>
            </Grid>

            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="车辆长度:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="LengthTextBox" TextChanged="DimensionChanged"/>
            </Grid>

            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="车辆宽度:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="WidthTextBox" TextChanged="DimensionChanged"/>
            </Grid>

            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="载重(kg):" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="LoadTextBox"/>
            </Grid>

            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="通讯方式:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="CommComboBox">
                    <ComboBoxItem Content="WiFi"/>
                    <ComboBoxItem Content="5G"/>
                    <ComboBoxItem Content="光通信"/>
                </ComboBox>
            </Grid>

            <Button x:Name="SaveButton" Content="保存" 
                    Width="200" Height="35" Margin="0,20,0,0" 
                    Click="SaveButton_Click"/>
        </StackPanel>

        <!-- 右侧 Canvas 车辆模型 -->
        <Canvas Grid.Column="1" Background="LightGray" x:Name="CarCanvas">
            <Rectangle x:Name="CarRectangle" Fill="SkyBlue" Stroke="DarkBlue" StrokeThickness="2"/>
        </Canvas>
    </Grid>
</Window>