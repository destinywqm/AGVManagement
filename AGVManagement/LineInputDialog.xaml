<Window x:Class="AGVManagement.LineInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AGVManagement"
        mc:Ignorable="d"
        Title="Mes响应点" Height="187" Width="287" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="27*"/>
            <ColumnDefinition Width="41*"/>
        </Grid.ColumnDefinitions>

        <!-- 起始点（改为下拉框，由后台动态填充） -->
        <Label Content="起始点:" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="27,18,0,0" Height="16" Width="48"/>
        <ComboBox x:Name="dataMesStart" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" Width="128" Height="30"/>

        <!-- 终止点（改为下拉框，由后台动态填充） -->
        <Label Content="终止点:" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="27,55,0,0" Height="16" Width="48" RenderTransformOrigin="0.503,2.13"/>
        <ComboBox x:Name="dataMesEnd" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,48,0,0" Width="128" Height="30"/>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Orientation="Horizontal" Grid.ColumnSpan="2" Margin="16,0,0,21" Height="54" Width="254">
            <Button Content="完成" Click="OnCompleteButtonClick" Width="100" Margin="10"/>
            <Button Content="取消" Click="OnCancelButtonClick" Width="100" Margin="10"/>
        </StackPanel>
    </Grid>
</Window>